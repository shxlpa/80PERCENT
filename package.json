{
  "name": "80percent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/dev.js",
    "build": "node server/build.js",
    "test": "node --test server/*.test.js",
    "start": "node server/serve.js",
    "backup": "node server/migrate.js",
    "test:browser": "node test-support/browser-parity.js"
  },
  "dependencies": {
    "@vercel/blob": "2.9.0",
    "sax": "1.6.1"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "undici": "6.29.1"
  }
}
